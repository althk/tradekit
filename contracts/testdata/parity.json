  "fills": {
    "_comment": [
      "The bar-replay fill rules. Four projects implemented these independently",
      "and agreed on the tie-break; this pins them so both libraries' paper",
      "brokers resolve an ambiguous bar identically.",
      "side is the side of the POSITION. stop/target of 0 mean the leg is unset.",
      "want_reason of '' means the bar triggers nothing."
    ],
    "cases": [
      {
        "name": "long: bar contains both levels, resolve as the stop",
        "side": "buy",
        "stop": 9500,
        "target": 11000,
        "open": 10000,
        "high": 11200,
        "low": 9400,
        "close": 10500,
        "want_price": 9500,
        "want_reason": "stop"
      },
      {
        "name": "long: gap through the stop fills at the open, not the stop",
        "side": "buy",
        "stop": 9500,
        "target": 0,
        "open": 9000,
        "high": 9200,
        "low": 8800,
        "close": 9100,
        "want_price": 9000,
        "want_reason": "stop"
      },
      {
        "name": "long: target only, stop untouched",
        "side": "buy",
        "stop": 9500,
        "target": 11000,
        "open": 10100,
        "high": 11200,
        "low": 9900,
        "close": 10800,
        "want_price": 11000,
        "want_reason": "target"
      },
      {
        "name": "long: gap through the target fills at the open",
        "side": "buy",
        "stop": 9500,
        "target": 11000,
        "open": 11500,
        "high": 11800,
        "low": 11400,
        "close": 11600,
        "want_price": 11500,
        "want_reason": "target"
      },
      {
        "name": "long: neither level reached",
        "side": "buy",
        "stop": 9500,
        "target": 11000,
        "open": 10100,
        "high": 10500,
        "low": 9900,
        "close": 10300,
        "want_price": 0,
        "want_reason": ""
      },
      {
        "name": "short: bar contains both levels, resolve as the stop",
        "side": "sell",
        "stop": 10500,
        "target": 9000,
        "open": 10000,
        "high": 10600,
        "low": 8900,
        "close": 9400,
        "want_price": 10500,
        "want_reason": "stop"
      },
      {
        "name": "short: gap through the stop fills at the open",
        "side": "sell",
        "stop": 10500,
        "target": 0,
        "open": 11000,
        "high": 11200,
        "low": 10800,
        "close": 11100,
        "want_price": 11000,
        "want_reason": "stop"
      },
      {
        "name": "short: target only",
